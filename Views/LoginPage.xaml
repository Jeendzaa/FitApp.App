<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             x:Class="FitApp.App.Views.LoginPage"
             xmlns:res="clr-namespace:FitApp.App.Resources.Languages"
             Title="LoginPage"
             >

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00AAFF" Offset="0.0"/>
            <GradientStop Color="#003CFF" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Padding="10">

        <Label
            Text="{x:Static res:AppResources.appName}"
            HorizontalTextAlignment="Center"
            FontFamily="JaroRegular"
            FontSize="70"
            TextColor="#FFF"
            Margin="0,30,0,0">

            <Label.Shadow>
                <Shadow Brush="Black"
                        Offset="0,5"
                        Radius="3"
                        Opacity="0.6"/>
            </Label.Shadow>

        </Label>

        <Border
            StrokeThickness="3"
            StrokeShape="RoundRectangle 12"
            Padding="0"
            Margin="0,60,0,0">

            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#034067" Offset="0.0"/>
                    <GradientStop Color="#5B9EFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Stroke>

            <Border
                BackgroundColor="#0162F4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                Padding="5">
                <Entry
                    Placeholder="{x:Static res:AppResources.loginPlaceholder}"
                    FontFamily="JaroRegular"
                    FontSize="25"
                    BackgroundColor="#0162F4"
                    Text="{Binding Email}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    TextColor="#FFF"
                    PlaceholderColor="#40FFFFFF"
                    />
            </Border>
        </Border>

        <Border
            StrokeThickness="3"
            StrokeShape="RoundRectangle 12"
            Padding="0"
            Margin="0,30,0,0">

            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#034067" Offset="0.0"/>
                    <GradientStop Color="#5B9EFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Stroke>

            <Border
                BackgroundColor="#0162F4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                Padding="5">
                <Entry
                    Placeholder="{x:Static res:AppResources.passwordPlaceholder}"
                    FontFamily="JaroRegular"
                    FontSize="25"
                    BackgroundColor="#0162F4"
                    Text="{Binding Password}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    TextColor="#FFF"
                    PlaceholderColor="#40FFFFFF"
                    IsPassword="True"
                    />
            </Border>
        </Border>

        <Border
            StrokeThickness="3"
            StrokeShape="RoundRectangle 16"
            Padding="0"
            Margin="60,30,60,0">

            <Border.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#034067" Offset="0.0"/>
                    <GradientStop Color="#5B9EFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Stroke>

            <Border
                BackgroundColor="#002679"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="5">

                <Button 
                    Text="{x:Static res:AppResources.loginButtonText}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontFamily="JaroRegular"
                    FontSize="26"
                    Command="{Binding LoginCommand}"
                    />
            </Border>
        </Border>

        <Label
            TextColor="#fff"
            Text="{x:Static res:AppResources.dontHaveAccountText}"
            FontFamily="JaroRegular"
            VerticalTextAlignment="Center"
            HorizontalTextAlignment="Center"
            Margin="0,50,0,0"
            FontSize="30"
            />
        <Label
            TextColor="#83AFFF"
            Text="{x:Static res:AppResources.createAccountLink}"
            FontFamily="JaroRegular"
            VerticalTextAlignment="Center"
            HorizontalTextAlignment="Center"
            FontSize="30">
            <Label.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding CreateAccountCommand}"
                    NumberOfTapsRequired="1"
                    />
            </Label.GestureRecognizers>
        </Label>

        
        
    </VerticalStackLayout>
</ContentPage>